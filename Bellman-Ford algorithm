#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

#define INF INT_MAX
// harshit patil 25070521104//
typedef struct {
    int u;
    int v;
    int weight;
} Edge;

int main() {
    int V, E;

    scanf("%d", &V);
    scanf("%d", &E);

    Edge *edges = (Edge *)malloc(E * sizeof(Edge));

    for (int i = 0; i < E; i++) {
        scanf("%d %d %d",
              &edges[i].u,
              &edges[i].v,
              &edges[i].weight);
    }

    int source;
    scanf("%d", &source);

    int *dist = (int *)malloc((V + 1) * sizeof(int));
    int *parent = (int *)malloc((V + 1) * sizeof(int));

    // Initialize distances and parents
    for (int i = 1; i <= V; i++) {
        dist[i] = INF;
        parent[i] = -1;
    }

    dist[source] = 0;

    // Bellman-Ford relaxation
    for (int i = 1; i <= V - 1; i++) {
        int updated = 0;

        for (int j = 0; j < E; j++) {
            int u = edges[j].u;
            int v = edges[j].v;
            int weight = edges[j].weight;

            if (dist[u] != INF &&
                dist[u] + weight < dist[v]) {

                dist[v] = dist[u] + weight;
                parent[v] = u;
                updated = 1;
            }
        }

        // Stop early if no distance was updated
        if (!updated)
            break;
    }

    // Check for a negative-weight cycle
    for (int i = 0; i < E; i++) {
        int u = edges[i].u;
        int v = edges[i].v;
        int weight = edges[i].weight;

        if (dist[u] != INF &&
            dist[u] + weight < dist[v]) {

            printf("Negative cycle detected\n");

            free(edges);
            free(dist);
            free(parent);

            return 0;
        }
    }

    // Print shortest paths
    for (int vertex = 1; vertex <= V; vertex++) {

        // Skip the source vertex
        if (vertex == source)
            continue;

        if (dist[vertex] == INF) {
            printf("%d INF None\n", vertex);
            continue;
        }

        // Construct path using parent array
        int path[V + 1];
        int pathLength = 0;
        int current = vertex;

        while (current != -1) {
            path[pathLength++] = current;

            if (current == source)
                break;

            current = parent[current];
        }

        printf("%d %d ", vertex, dist[vertex]);

        // Print path in source -> destination order
        for (int i = pathLength - 1; i >= 0; i--) {
            printf("%d", path[i]);

            if (i > 0)
                printf("->");
        }

        printf("\n");
    }

    free(edges);
    free(dist);
    free(parent);

    return 0;
}
