#include <stdio.h>

#define MAX 100
// harshit patil 25070521104//
int arr[MAX];
int subset[MAX];
int results[MAX][MAX];
int resultSize[MAX];

int n, target;
int count = 0;

void findSubsets(int index, int sum, int size) {
    if (index == n) {
        if (sum == target) {
            for (int i = 0; i < size; i++) {
                results[count][i] = subset[i];
            }

            resultSize[count] = size;
            count++;
        }
        return;
    }

    // Include current element
    subset[size] = arr[index];
    findSubsets(index + 1, sum + arr[index], size + 1);

    // Exclude current element
    findSubsets(index + 1, sum, size);
}

int main() {
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    scanf("%d", &target);

    findSubsets(0, 0, 0);

    if (count == 0) {
        printf("-1\n");
    } else {
        // Print subsets in reverse order of discovery
        for (int i = count - 1; i >= 0; i--) {
            for (int j = 0; j < resultSize[i]; j++) {
                printf("%d ", results[i][j]);
            }
            printf("\n");
        }
    }

    return 0;
}
