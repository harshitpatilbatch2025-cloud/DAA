#include <stdio.h>
#include <stdlib.h>

int main() {
    int n;
    scanf("%d", &n);

    int *value = (int *)malloc(n * sizeof(int));
    int *weight = (int *)malloc(n * sizeof(int));

    for (int i = 0; i < n; i++) {
        scanf("%d", &value[i]);
    }

    for (int i = 0; i < n; i++) {
        scanf("%d", &weight[i]);
    }

    int capacity;
    scanf("%d", &capacity);

    int *dp = (int *)calloc(capacity + 1, sizeof(int));

    for (int i = 0; i < n; i++) {
        for (int w = capacity; w >= weight[i]; w--) {
            int include = dp[w - weight[i]] + value[i];

            if (include > dp[w]) {
                dp[w] = include;
            }
        }
    }

    printf("%d\n", dp[capacity]);

    free(value);
    free(weight);
    free(dp);

    return 0;
}
