int main(void)
{
	int m, n;
	scanf("%d %d", &m, &n);

	int m1[m][n];


	for (int i = 0; i < m; i++)
	{
		for (int j = 0; j < n; j++)
		{
			scanf("%d", &m1[i][j]);
		}
	}

	int o, p;
	scanf("%d %d", &o, &p);


	if (n != o)
	{
		printf("Invalid input");
		return 0;
	}

	int m2[o][p];
	for (int i = 0; i < o; i++)
	{
		for (int j = 0; j < p; j++)
		{
			scanf("%d", &m2[i][j]);
		}
	}

	int m3[m][p];
	for (int i = 0; i < m; i++)
	{
		for (int j = 0; j < p; j++)
		{
			m3[i][j] = 0;
			for (int k = 0; k < n; k++)
			{
			m3[i][j] += m1[i][k] * m2[k][j];
			}
		}
	}

	for (int i = 0; i < m; i++)
	{
		for (int j = 0; j < p; j++)
		{
			printf("%d ", m3[i][j]);
		}
		printf("\n");
	}

	return 0;
}
