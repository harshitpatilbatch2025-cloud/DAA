#include <stdio.h>

#define MAX 15
#define INF 1000000000

int n;
int cost[MAX][MAX];
int dp[1 << MAX][MAX];

/*
    dp[mask][city] =
    minimum cost to visit all cities in 'mask'
    and currently be at 'city'
*/

int tsp(int mask, int city) {
    // All cities have been visited
    if (mask == (1 << n) - 1) {
        // Return to the starting city (city 0)
        if (cost[city][0] == -1)
            return INF;

        return cost[city][0];
    }

    // Already calculated
    if (dp[mask][city] != -1)
        return dp[mask][city];

    int answer = INF;

    // Try visiting every unvisited city
    for (int next = 0; next < n; next++) {
        if (!(mask & (1 << next)) && cost[city][next] != -1) {
            int newCost = cost[city][next] +
                          tsp(mask | (1 << next), next);

            if (newCost < answer)
                answer = newCost;
        }
    }

    dp[mask][city] = answer;

    return answer;
}

int main() {
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);
        }
    }

    // Initialize DP table
    int totalMasks = 1 << n;

    for (int i = 0; i < totalMasks; i++) {
        for (int j = 0; j < n; j++) {
            dp[i][j] = -1;
        }
    }

    // Start from city 0
    int answer = tsp(1, 0);

    printf("%d\n", answer);

    return 0;
}
